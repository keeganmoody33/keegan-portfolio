# Copy this file to .env.local and fill in your values

# Supabase - get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# PostHog - get from https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Discogs - personal access token for the Discogs API (optional; public collection works without it)
# Generate at https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Upstash Redis (Vercel Marketplace "Upstash for Redis") — last-good Discogs crate.
# Injected by the integration. Without these vars, Discogs behaves as before (in-memory last-good).
# Code reads KV_REST_API_URL + KV_REST_API_TOKEN first, then UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron — daily crate enrichment drain. Name only; value is set by Vercel.
# CRON_SECRET=

# Test hook — comma-separated Discogs release ids or * to fail the next enrich
# and preserve last-good (error + backoff). Preview/dev only.
# CRATE_ENRICH_FAIL_IDS=

# Vercel Blob — public cover store. Unset = cover sync discovers only; CAA is not uploaded.
# BLOB_READ_WRITE_TOKEN=

# everysong.site — preview /flip search + lookup only. Do not add to Vercel production.
# Unset → the room shows "couldn't reach everysong." Fixtures via ?stub= on non-prod
# (including stub=suggest for Donny Hathaway typeahead).
# EVERYSONG_API_KEY=

# Resend — preview /flip operator email after a stored request. Do not add to
# Vercel production. Unset → skip the email; the visitor still gets success.
# FLIP_NOTIFY_FROM must be a verified Resend domain. Defaults:
#   from doingflips <33@lecturesfrom.com>
#   to   33@lecturesfrom.com
# Fetch sends Idempotency-Key: flip-request/${at} (stored ISO, not contact).
# RESEND_API_KEY=
# FLIP_NOTIFY_FROM=
# FLIP_NOTIFY_TO=
